# Usuarios del backoffice: se crean desde el panel (Administración → Usuarios)
# o se inicializan en localStorage al primer acceso (ver src/lib/backofficeUserStore.ts).

# Supabase (opcional): copia a `.env` y rellena la anon key desde
# Supabase Dashboard → Project Settings → API → Project API keys → anon public
VITE_SUPABASE_URL=https://grasrjavkbeboynacvzp.supabase.co
VITE_SUPABASE_ANON_KEY=

# Generador masivo desde el panel: en desarrollo, en otra terminal: npm run bulk-invoice-api
# Mismo proyecto Supabase: URL (puede ser solo VITE_SUPABASE_URL) + service_role SOLO para este proceso.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: logo en cabecera de factura (URL pública https://... o ruta file:///... local).
# BULK_INVOICE_LOGO_URL=
# Opcional: URL absoluta del API (p. ej. https://tu-dominio.com); si vacío, Vite proxy a 127.0.0.1:3847
# VITE_BULK_INVOICE_API_URL=

# Asistente IA: las claves y el proveedor NO van aquí. Son secretos de la Edge Function:
#   AI_PROVIDER=openai|ollama|mock
#   OPENAI_API_KEY / OPENAI_MODEL
#   OLLAMA_BASE_URL / OLLAMA_MODEL / OLLAMA_API_KEY
# Nunca uses VITE_OPENAI_API_KEY ni VITE_OLLAMA_*.
# Corte a Ollama en producción: docs/AI_OLLAMA_SETUP.md (no se aplica solo por existir este comentario).
